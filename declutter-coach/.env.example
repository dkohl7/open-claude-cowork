# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Required: at least 8 characters. Jessica types it once on her phone.
APP_PASSCODE=

# Optional: change the port
PORT=3456

# Optional: where chats are saved (point this at a persistent disk when hosting online)
# DATA_DIR=/var/data/maple

# Set to 1 when hosting behind a proxy like Render or Railway
# TRUST_PROXY=1
